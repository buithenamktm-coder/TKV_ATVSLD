diff --git a/src/gui/RGraphicsViewQt.cpp b/src/gui/RGraphicsViewQt.cpp
index 9fa43102..69b68c9b 100644
--- a/src/gui/RGraphicsViewQt.cpp
+++ b/src/gui/RGraphicsViewQt.cpp
@@ -24,2 +24,5 @@
 #include "RDocumentInterface.h"
+#include "RDocument.h"
+#include "RAction.h"
+#include "RGuiAction.h"
 #include "RGraphicsViewImage.h"
@@ -46,2 +49,6 @@ RGraphicsViewQt::RGraphicsViewQt(QWidget* parent, bool showFocus)

+    // IMSAT CAD (GPLv3): expose the native drawing surface to Windows UIA.
+    setObjectName("IMSATCADGraphicsCanvas");
+    setAccessibleName("IMSAT CAD drawing canvas");
+
     setFocusPolicy(Qt::WheelFocus);
@@ -294,2 +301,6 @@ void RGraphicsViewQt::mousePressEvent(QMouseEvent* event) {
     imageView->handleMousePressEvent(e);
+    // Diagnostic is enabled only on Windows acceptance runners.
+    if (qEnvironmentVariableIsSet("IMSATCAD_MOUSE_QA") && event->button()==Qt::LeftButton) {
+        qWarning() << "IMSATCAD_MOUSE_QA PRESS" << event->pos().x() << event->pos().y();
+    }
     lastButtonState = event->buttons();
@@ -346,2 +357,13 @@ void RGraphicsViewQt::mouseReleaseEvent(QMouseEvent* event) {
     imageView->handleMouseReleaseEvent(e);
+    if (qEnvironmentVariableIsSet("IMSATCAD_MOUSE_QA") && event->button()==Qt::LeftButton) {
+        RDocumentInterface* auditDi = imageView->getDocumentInterface();
+        int auditEntityCount = auditDi==NULL ? -1 : auditDi->getDocument().queryAllEntities().size();
+        QString auditFileName = auditDi==NULL ? QString() : auditDi->getDocument().getFileName();
+        RAction* auditAction = auditDi==NULL ? NULL : auditDi->getCurrentAction();
+        RGuiAction* auditGuiAction = auditAction==NULL ? NULL : auditAction->getGuiAction();
+        QString auditScript = auditGuiAction==NULL ? QString() : auditGuiAction->getScriptFile();
+        qWarning() << "IMSATCAD_MOUSE_QA RELEASE" << event->pos().x() << event->pos().y()
+                   << "EntityCount" << auditEntityCount << "FileName" << auditFileName
+                   << "Action" << auditScript;
+    }
     lastButtonState = event->buttons();
