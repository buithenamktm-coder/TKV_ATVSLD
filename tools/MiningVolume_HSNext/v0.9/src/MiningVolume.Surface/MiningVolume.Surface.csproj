<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MiningVolume.Surface</AssemblyName>
    <RootNamespace>MiningVolume.Surface</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiningVolume.Core\MiningVolume.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="BuildNativeCdt" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/Native/build_native.py&quot; --output &quot;$(TargetDir)MiningVolume.Cdt.Native.dll&quot;" />
  </Target>
</Project>